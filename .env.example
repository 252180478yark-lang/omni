# ═══ Omni-Vibe OS Ultra — 环境变量 ═══
# 复制为 .env 并填写实际值：cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=omni_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=omni_vibe_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=changeme_redis
REDIS_PORT=6379

# --- Nginx ---
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- Embedding Model ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2-preview

# --- 代理设置（国内访问 OpenAI/Gemini 等）---
# Docker Compose 会把它注入各服务：优先 HTTP_PROXY/HTTPS_PROXY，否则用 PROXY_URL。
# 容器内不要用 127.0.0.1，应指向宿主机，例如 Clash「混合端口」12334：
#   PROXY_URL=http://host.docker.internal:12334
# Clash「允许来自局域网的连接」建议开启，否则 Docker 网桥访问宿主机代理可能被拒绝。
PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=

# --- S8 runtime trace / S10 Host Bridge (paths only; keep secret files outside the repo) ---
OMNI_RUNTIME_TRACE_TOKEN_FILE=
OMNI_RUNTIME_TRACE_SERVICE_TOKEN_FILE=
OMNI_COMPATIBILITY_TOKEN_FILE=
# Public Next build flag: set to 0, rebuild, and redeploy to restore the legacy Shell.
NEXT_PUBLIC_OMNI_UNIFIED_SHELL=true
OMNI_KE_URL=http://127.0.0.1:8002
OMNI_HOST_BRIDGE_URL=http://127.0.0.1:7777
OMNI_HOST_TOKEN_FILE=
OMNI_HOST_ALLOWED_PROJECT_ROOTS=E:\agent
OMNI_HOST_STATE_DIR=
OMNI_HOST_INSTANCE_ID=host:local
OMNI_HOST_EXECUTION_ENABLED=false
OMNI_HOST_VISIBLE_AUTH_ORIGINS=
OMNI_AGENT_RUNNER_MODE=auto
OMNI_AGENT_PROVIDER=codex
OMNI_PROJECT_DIR=E:\agent\omni
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=
