{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/scripts/hooks/development_gate.py\" --event SessionStart --timeout 40",
            "commandWindows": "python -B -c \"import pathlib,runpy,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()); p=str(r/'scripts'/'hooks'/'development_gate.py'); sys.argv=[p,'--event','SessionStart','--timeout','40']; runpy.run_path(p,run_name='__main__')\"",
            "timeout": 45,
            "statusMessage": "Checking Omni delivery and development context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/scripts/hooks/development_gate.py\" --event PreToolUse --timeout 8",
            "commandWindows": "python -B -c \"import pathlib,runpy,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()); p=str(r/'scripts'/'hooks'/'development_gate.py'); sys.argv=[p,'--event','PreToolUse','--timeout','8']; runpy.run_path(p,run_name='__main__')\"",
            "timeout": 10,
            "statusMessage": "Classifying risk, contract path, and workspace lease"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/scripts/hooks/development_gate.py\" --event Stop --timeout 35",
            "commandWindows": "python -B -c \"import pathlib,runpy,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()); p=str(r/'scripts'/'hooks'/'development_gate.py'); sys.argv=[p,'--event','Stop','--timeout','35']; runpy.run_path(p,run_name='__main__')\"",
            "timeout": 40,
            "statusMessage": "Running minimal deterministic completion checks"
          }
        ]
      }
    ]
  }
}
