{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni.feature-definition.v1",
  "title": "Omni FeatureDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "title",
    "domain",
    "owner",
    "lifecycle",
    "routes",
    "ia",
    "capabilities",
    "expected_edges",
    "checks",
    "aliases",
    "dependencies"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "feature_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["team", "service", "person"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "lifecycle": {"enum": ["active", "deprecated", "archived"]},
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "visible", "placements", "owned_surfaces"],
      "properties": {
        "canonical": {"$ref": "#/$defs/href"},
        "visible": {"type": "boolean"},
        "placements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["sidebar", "home", "onboarding", "direct"]}
        },
        "owned_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/href"}
        }
      }
    },
    "ia": {"$ref": "#/$defs/ia"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "kind"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "kind": {"enum": ["read", "write", "generate", "admin"]}
        }
      }
    },
    "expected_edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "aliases": {
      "type": "array",
      "items": {"$ref": "#/$defs/alias"}
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    }
  },
  "$defs": {
    "href": {"type": "string", "pattern": "^/[^?#]*$"},
    "work_group": {
      "enum": ["today", "products", "operations", "content", "knowledge"]
    },
    "development_group": {
      "enum": ["agents", "skills-tools", "workflows", "prompt-eval", "runs-system"]
    },
    "ia_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "group", "order"],
      "properties": {
        "mode": {"enum": ["work", "development"]},
        "group": {
          "enum": [
            "today",
            "products",
            "operations",
            "content",
            "knowledge",
            "agents",
            "skills-tools",
            "workflows",
            "prompt-eval",
            "runs-system"
          ]
        },
        "order": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "work"}}},
          "then": {"properties": {"group": {"$ref": "#/$defs/work_group"}}},
          "else": {"properties": {"group": {"$ref": "#/$defs/development_group"}}}
        }
      ]
    },
    "ia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "primary_group",
        "primary_order",
        "contextual_groups",
        "phase",
        "flag"
      ],
      "properties": {
        "mode": {"enum": ["work", "development"]},
        "primary_group": {
          "enum": [
            "today",
            "products",
            "operations",
            "content",
            "knowledge",
            "agents",
            "skills-tools",
            "workflows",
            "prompt-eval",
            "runs-system"
          ]
        },
        "primary_order": {"type": "integer", "minimum": 0},
        "contextual_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ia_placement"}
        },
        "phase": {
          "enum": ["retain", "merge", "degrade", "host_only", "retirement_candidate"]
        },
        "flag": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "work"}}},
          "then": {"properties": {"primary_group": {"$ref": "#/$defs/work_group"}}},
          "else": {"properties": {"primary_group": {"$ref": "#/$defs/development_group"}}}
        }
      ]
    },
    "node_ref": {"type": "string", "pattern": "^[a-z_]+:.+$"},
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation", "required"],
      "properties": {
        "from": {"$ref": "#/$defs/node_ref"},
        "to": {"$ref": "#/$defs/node_ref"},
        "relation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "required": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "target", "verifies", "required"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "kind": {"enum": ["pytest", "command", "schema", "health"]},
        "target": {"type": "string", "minLength": 1},
        "verifies": {"$ref": "#/$defs/node_ref"},
        "required": {"type": "boolean"}
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "target"],
      "properties": {
        "href": {"$ref": "#/$defs/href"},
        "target": {"$ref": "#/$defs/href"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "required"],
      "properties": {
        "ref": {"$ref": "#/$defs/node_ref"},
        "required": {"type": "boolean"}
      }
    }
  }
}
