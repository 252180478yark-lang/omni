# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://omni_user:changeme_in_production@localhost:5432/omni_vibe_db

# ── 抖店 ──────────────────────────────────────────────────────────────────────
DOUYIN_SHOP_ID=153xxxxx
# MVP_DOUYIN_PRODUCT_IDS and MVP_SKU_IDS are deprecated; sku_bootstrapper auto-syncs from g-list

# ── 巨量云图 ──────────────────────────────────────────────────────────────────
YUNTU_BRAND_ID=WADAKAN_HETIANKUAN
YUNTU_INDUSTRY=food_beverage

# ── 通知通道（全部可选，留空 = 该通道静默）──────────────────────────────────
WECOM_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_INAPP_ENABLED=true
NOTIFICATION_BROWSER_PUSH=true
NOTIFICATION_WECOM_ENABLED=auto
NOTIFICATION_EMAIL_ENABLED=auto

# ── AI Hub ───────────────────────────────────────────────────────────────────
AI_HUB_URL=http://localhost:8001

# ── Scheduler ────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true
SCHEDULE_CRON=30 8 * * *
