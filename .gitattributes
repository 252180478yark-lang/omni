* text=auto

# Keep executable/configuration sources deterministic across Windows hosts and
# Linux CI/containers. Binary assets continue to be detected automatically.
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.pdf binary
*.ps1 text eol=crlf
*.bat text eol=crlf
