{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni.local/schemas/runtime-allocation.schema.json",
  "title": "Omni RuntimeAllocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["allocation_id", "lease_id", "repository_id", "worktree_id", "change_id", "owner", "canonical", "runtime_id", "compose_project", "ports", "database", "database_schema", "volumes", "redis_namespace", "cron_owner", "approval_worker_owner", "risk_level", "build_sha", "source_fingerprint", "created_at", "expires_at", "state", "revision"],
  "properties": {
    "allocation_id": {"type": "string", "pattern": "^allocation-[0-9a-f]{32}$"},
    "lease_id": {"type": "string", "pattern": "^lease-[0-9a-f]{32}$"},
    "repository_id": {"type": "string", "pattern": "^repo-[0-9a-f]{16}$"},
    "worktree_id": {"type": "string", "pattern": "^worktree-[0-9a-f]{16}$"},
    "change_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "canonical": {"type": "boolean"},
    "runtime_id": {"type": "string", "minLength": 1},
    "compose_project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "ports": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "database_schema": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "volumes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "redis_namespace": {"type": "string", "minLength": 1},
    "cron_owner": {"type": "boolean"},
    "approval_worker_owner": {"type": "boolean"},
    "risk_level": {"enum": ["R0", "R1", "R2", "R3"]},
    "build_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["active", "stale", "released"]},
    "revision": {"type": "integer", "minimum": 1},
    "released_at": {"type": "string", "format": "date-time"}
  }
}
